# Local-only values. Copy this file to .env and fill in your own values.
# Never commit the real API key.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. The server defaults to eleven_v4.
ELEVENLABS_MODEL_ID=eleven_v4

# Optional brain bridge. Get a Gemini API key from Google AI Studio.
GEMINI_API_KEY=
# Optional. Netlify currently defaults this project to gemini-3.6-flash.
GEMINI_MODEL=gemini-3.6-flash
